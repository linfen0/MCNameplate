{
  "name": "minecraft-nameplate",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Minecraft 像素风格方形名牌生成器：上传皮肤 + ID，自动生成黄金分割布局的方形名牌图片",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:visual": "tsc --noEmit && vite build && node scripts/visual-check.mjs",
    "check": "tsc --noEmit && vitest run && node scripts/visual-check.mjs",
    "build:font": "node scripts/build-bitmap-font.mjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright-core": "^1.63.0",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
